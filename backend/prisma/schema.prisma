datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  employeeId             String   @id
  fullName               String
  dob                    String?  @default("")
  designation            String   @default("Team Member")
  department             String   @default("General")
  email                  String   @unique // Office Email Address
  password               String?  @default("") // Salted scrypt password hash
  personalEmail          String?  @default("")
  phone                  String   // Mobile Number
  secondaryPhone         String?  @default("")
  permanentAddress       String?  @default("")
  gender                 String?  @default("Not Specified") // Male, Female, Not Specified
  guardianName           String?  @default("") // Father's or Guardian name
  motherName             String?  @default("") // Mother's name
  bloodGroup             String?  @default("")
  linkedInUrl            String?  @default("")
  aadhaarNumber          String?  @default("")
  panNumber              String?  @default("")
  costRate               String   @default("₹0/hr")
  capacity               String   @default("40 hrs/week")
  joiningDate            String?  @default("")
  relievingDate          String?  @default("")
  status                 String   @default("Active") // Active, Inactive
  role                   String   @default("Employee") // Super Admin, Project Manager, Employee
  location               String   @default("Delhi, India")
  avatar                 String?  @db.LongText

  // Bank & Payout Details
  bankName               String?  @default("")
  branchName             String?  @default("")
  ifscCode               String?  @default("")
  accountNumber          String?  @default("")
  accountHolderName      String?  @default("")
  accountType            String?  @default("Savings") // Savings, Current
  upiId                  String?  @default("")

  // Merged Education & Experience
  education              Json?    // Array of { degree, school, year }
  experience             Json?    // Array of { company, role, period }

  // Merged Leave Balances & Quotas
  leaveYear              Int      @default(2026)
  casualQuota            Float    @default(12)
  casualUsed             Float    @default(0)
  sickQuota              Float    @default(12)
  sickUsed               Float    @default(0)
  earnedQuota            Float    @default(15)
  earnedUsed             Float    @default(0)
  compOffBalance         Float    @default(0)
  compOffRequests        Json?    // Array of { id, workedDate, hoursWorked, daysCredit, reason, status, pmApproval, saApproval, createdAt }
  optionalHolidaysQuota  Int      @default(2)
  optionalHolidaysUsed   Int      @default(0)
  wfhMonthlyLimit        Int      @default(2)
  wfhUsedThisMonth       Int      @default(0)
  lastAccruedMonth       String?  @default("")
}



model Client {
  id                 String       @id
  name               String
  legalName          String?      @default("")
  displayName        String?      @default("")
  contactPerson      String?      @default("")
  email              String?      @default("") // Contact Email
  phone              String?      @default("") // Contact Phone
  accountsPerson     String?      @default("")
  accountsEmail      String?      @default("")
  accountsPhone      String?      @default("")
  address            String?      @default("") // Office Address
  country            String?      @default("India")
  cinNumber          String?      @default("")
  gstNumber          String?      @default("")
  panNumber          String?      @default("")
  msmeNumber         String?      @default("")
  billingCurrency    String       @default("USD ($)")
  defaultBillingType String       @default("T&M")
  dueTime            String       @default("30 days") // 15 days, 30 days, 45 days, 60 days, 90 days
  status             String       @default("Active") // Active, Inactive
  projects           Project[]
  clientUsers        ClientUser[]
}

model ClientUser {
  id          String              @id
  name        String
  username    String              @unique
  email       String              @unique
  phone       String              @default("")
  password    String              @default("") // Hashed password
  status      String              @default("Active") // Active, Inactive
  clientId    String
  client      Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt
  
  projects    ClientUserProject[]

  @@index([clientId])
  @@index([email])
  @@index([username])
}

model ClientUserProject {
  id           Int        @id @default(autoincrement())
  clientUserId String
  projectId    String
  clientId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([clientUserId, projectId])
  @@index([clientUserId])
  @@index([projectId])
  @@index([clientId])
}

model Project {
  id                      String                 @id
  name                    String
  billingType             String // T&M, Fixed RC, Fixed PC
  rate                    String
  currency                String                 @default("USD ($)")
  businessLine            String?                @default("")
  service                 String?                @default("")
  startDate               String?                @default("")
  endDate                 String?                @default("")
  budgetHours             Int                    @default(0)
  budgetType              String                 @default("Monthly") // Monthly, Total Project
  loggedHours             Int                    @default(0)
  status                  String // Active, Inactive
  managerId               String?                @default("")
  managerName             String?                @default("")
  assignedEmployees       String?                @default("")
  clientContactPersonId   String?                @default("")
  clientContactPersonName String?                @default("")
  clientId                String
  client                  Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  // Merged Monthly Budgets & Rate Versions
  monthlyBudgets          Json?                  // Array of { monthYear: string, budgetHours: number, isLocked: boolean, updatedAt: string }
  rateVersions            Json?                  // Array of { id: number, billingType: string, rateAmount: number, currency: string, effectiveStartDate: string, effectiveEndDate: string, notes: string, createdAt: string }

  dailyEntries            DailyTimesheetEntry[]
  clientUsers             ClientUserProject[]
}

model BusinessLine {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?   @default("")
  status      String    @default("Active")
  services    Service[]
}

model Service {
  id             Int           @id @default(autoincrement())
  name           String
  businessLineId Int?
  businessLine   BusinessLine? @relation(fields: [businessLineId], references: [id], onDelete: Cascade)
  status         String        @default("Active")
}

model StudioSetting {
  id                  String   @id @default("default")
  studioName          String   @default("Orangyy Design Studio")
  legalName           String   @default("Orangyy Design Private Limited")
  contactEmail        String   @default("admin@orangy.design")
  studioDomain        String   @default("orangy.design")
  standardCapacity    String   @default("40")
  timezone            String   @default("Asia/Kolkata (IST +5:30)")
  approvalWorkflow    String   @default("Two-Step (PM -> Super Admin Lock)")
  defaultCurrency     String   @default("USD ($)")
  defaultPaymentTerms String   @default("30 days")
  defaultBillingType  String   @default("T&M")
  updatedAt           DateTime @default(now()) @updatedAt
}

model MonthlyExchangeRate {
  id              Int      @id @default(autoincrement())
  sourceCurrency  String   // e.g. USD, EUR, GBP, AED, SGD, CAD, JPY, CHF
  targetCurrency  String   @default("INR") // e.g. INR
  rate            Float    // Exchange rate value
  month           Int      // 1 - 12
  year            Int      // e.g. 2026
  effectivePeriod String   // e.g. "Sep 2026" or "2026-09"
  syncedAt        DateTime @default(now())
  source          String   @default("open.er-api.com")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([sourceCurrency, targetCurrency, year, month])
  @@index([sourceCurrency, targetCurrency])
  @@index([year, month])
}

model ExchangeRate {
  id        Int      @id @default(autoincrement())
  currency  String   // e.g. USD, EUR, GBP, AED, SGD, CAD, JPY, CHF, INR
  rateToINR Float    // Multiplier to convert to INR (e.g. 87.50)
  monthYear String   // e.g. 2026-08
  isLocked  Boolean  @default(false)
  fetchedAt DateTime @default(now())
  source    String   @default("online")
}

model DailyTimesheetEntry {
  id          Int      @id @default(autoincrement())
  date        String   // e.g. 2026-08-17
  dayLabel    String   // e.g. Aug 17, Mon
  sno         String   // e.g. 01, 02...
  description String   @default("")
  task        String   @default("") // e.g. Ideation, Design, AI Design, Validation, Analysis, Approval
  hours       Float    @default(0)
  isBillable  Boolean  @default(true)
  projectId   String
  employeeId  String?  @default("")
  weekStart   String   // e.g. 2026-08-17
  status      String   @default("Draft") // Draft, Submitted, PM_Approved, Approved
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date, employeeId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    String?
  role      String?   // 'Employee', 'Project Manager', 'Super Admin', or 'All'
  title     String
  message   String
  type      String    // 'timesheet_submit', 'timesheet_approve', 'timesheet_reopen', 'project_assign', 'deadline_reminder'
  projectId String?   @default("")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model LeaveTypeConfig {
  id              Int      @id @default(autoincrement())
  code            String   // 'CL', 'SL', 'EL', 'WFH', 'COMP_OFF', 'OH'
  name            String
  annualQuota     Float    @default(12)
  monthlyAccrual  Float    @default(1.0)
  allowHalfDay    Boolean  @default(true)
  maxCarryForward Float    @default(0)
  isPaid          Boolean  @default(true)
  status          String   @default("Active")
  year            Int      @default(2026)

  @@unique([code, year])
}

model Holiday {
  id          Int      @id @default(autoincrement())
  date        String   // '2026-01-26'
  name        String   // 'Republic Day' / 'Maha Shivratri'
  type        String   @default("Mandatory") // 'Mandatory' or 'Optional'
  year        Int      @default(2026)
  isPublished Boolean  @default(true)
}

model LeaveRequest {
  id              Int      @id @default(autoincrement())
  employeeId      String
  employeeName    String
  leaveType       String   // 'Casual Leave', 'Sick Leave', 'Earned Leave', 'Comp-off', 'Work From Home', 'Optional Holiday'
  startDate       String
  endDate         String
  isHalfDay       Boolean  @default(false)
  halfDaySession  String?  // 'First Half' or 'Second Half'
  daysCount       Float    // 0.5, 1.0, 2.0...
  reason          String
  status          String   @default("Pending") // 'Pending', 'Approved', 'Rejected', 'Cancelled'
  approverId      String?
  approverName    String?
  pmApproval      String?  @default("Pending")
  saApproval      String?  @default("Pending")
  rejectionReason String?
  appliedAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model LoginLog {
  id          Int      @id @default(autoincrement())
  employeeId  String?  @default("")
  fullName    String
  email       String
  role        String?  @default("Employee")
  ipAddress   String
  city        String?  @default("")
  region      String?  @default("")
  country     String?  @default("")
  latitude    Float?
  longitude   Float?
  os          String?  @default("Unknown OS")
  browser     String?  @default("Unknown Browser")
  deviceType  String?  @default("Desktop / Web")
  networkInfo String?  @default("")
  userAgent   String?  @db.Text
  loginAt     DateTime @default(now())

  @@index([loginAt])
  @@index([email])
  @@index([ipAddress])
  @@index([employeeId])
}

